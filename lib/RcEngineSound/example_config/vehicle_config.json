{
  "vehicle": {
    "name": "Scania V8" // Display name for the vehicle
  },
  "engine": {
    "acc": 2, // Acceleration speed (1=slowest/heavy, 9=fastest/light)
    "dec": 1, // Deceleration speed (1=slowest/heavy, 5=fastest/light)
    "maxRpmPercentage": 310, // Max engine RPM as a percentage of idle (e.g., 310% of idle RPM)
    "clutchEngagingPoint": 100, // PWM value where the clutch starts engaging (sound sync)
    "revSwitchPoint": 50, // RPM point where "Rev" sound begins to mix into "Idle" sound
    "idleEndPoint": 300, // RPM point where "Idle" sound is completely replaced by "Rev"
    "dieselKnockInterval": 8, // Number of "knock" pulses per engine cycle (e.g., 8 for V8)
    "dieselKnockStartPoint": 110, // RPM point where diesel knocking sound starts to get louder
    "jakeBrakeMinRpm": 200, // Minimum RPM for the Jake Brake (Compression Brake) to trigger
    "fanStartPoint": 0 // RPM point where the engine cooling fan noise begins
  },
  "transmission": {
    "automatic": false, // If true, simulates an automatic transmission with torque converter
    "numberOfGears": 3, // Number of gears for automatic simulation (3, 4, or 6)
    "doubleClutch": false, // Enable double-clutch sound simulation for manual shifts
    "shiftingAutoThrottle": true // Synchronize engine RPM automatically during gear shifts
  },
  "sound_volume": {
    "master": 100, // Global volume multiplier for all sounds (%)
    "start": 140, // Volume of the engine start sound (%)
    "idle": 80, // Volume of the engine idling sound (%)
    "engineIdle": 50, // Volume of the base engine block sound during idle (%)
    "fullThrottle": 150, // Maximum volume scaling achieved at full throttle (%)
    "rev": 100, // Volume of the engine revving sound (%)
    "engineRev": 50, // Volume of the base engine block sound during revving (%)
    "turbo": 40, // Maximum volume of the turbo whistle (%)
    "knock": 200, // Volume of the diesel knocking sound effect (%)
    "wastegate": 100, // Volume of the turbo wastegate/blow-off sound (%)
    "horn": 100, // Volume of the main vehicle horn (%)
    "siren": 100, // Volume of the emergency/additional siren (%)
    "brake": 150, // Volume of the air brake release sound (%)
    "parkingBrake": 150, // Volume of the parking brake engage/disengage sound (%)
    "shifting": 100, // Volume of mechanical gear shift clunk sounds (%)
    "reversing": 70, // Volume of the reversing beeper sound (%)
    "indicator": 100, // Volume of the turn signal clicker sound (%)
    "coupling": 100, // Volume of the trailer coupling/uncoupling sounds (%)
    "jakeBrake": 150, // Volume of the jake brake sound effect (%)
    "fan": 0 // Volume of the engine cooling fan sound effect (%)
  }
}